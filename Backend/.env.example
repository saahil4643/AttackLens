# AttackLens Backend Production Environment Variables

# Django Security
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-50-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,attacklens.yourdomain.com

# PostgreSQL Database Configuration
DATABASE_URL=postgres://attacklens_user:attacklens_secure_password@db:5432/attacklens_db
# Or specify individual credentials:
# DB_NAME=attacklens_db
# DB_USER=attacklens_user
# DB_PASSWORD=attacklens_secure_password
# DB_HOST=db
# DB_PORT=5432

# CORS & CSRF Configuration
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://localhost:3000,http://localhost:5173,https://attacklens.yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://localhost:3000,http://localhost:8000,https://attacklens.yourdomain.com

# SSL / Security Toggles (Enable if HTTPS termination is enabled)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# Logging
DJANGO_LOG_LEVEL=INFO
