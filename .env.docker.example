# AttackLens Docker Compose Deployment Environment Variables

# Frontend Port (Port exposed on the host machine)
PORT=80

# PostgreSQL Credentials
POSTGRES_DB=attacklens_db
POSTGRES_USER=attacklens_user
POSTGRES_PASSWORD=generate_a_strong_database_password_here

# Django Backend Configuration
DJANGO_SECRET_KEY=generate_a_secure_random_django_secret_key_here_50_chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=backend,localhost,127.0.0.1,yourdomain.com

# CORS / CSRF Origins
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://yourdomain.com,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:80,http://yourdomain.com,https://yourdomain.com

# Logging
DJANGO_LOG_LEVEL=INFO
